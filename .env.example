# === Kuanto-App — variables de entorno (plantilla) ===
# Copia este archivo como .env y rellena los valores.
# .env NUNCA se sube al repositorio (ver .gitignore).
#
# Para Expo SDK 49+, las variables EXPO_PUBLIC_* se exponen al cliente.

# --- Supabase (público, llega al cliente) ---
# URL del proyecto Supabase de la app móvil (tabla pública de solo lectura).
EXPO_PUBLIC_SUPABASE_URL="https://ghyznbisjcdmtuaelhmg.supabase.co"
# Publishable key (pública por diseño, RLS protege los datos).
EXPO_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_TU_KEY_AQUI"

# --- Supabase (solo servidor, NUNCA en el cliente) ---
# service_role secret para los cron jobs y Edge Functions.
# ⚠️ Si esta clave estuvo commiteada, HAY QUE ROTARLA en el dashboard de Supabase.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_TU_SECRET_AQUI"
SUPABASE_URL="https://goiaxsdsrwxlebpsnbrx.supabase.co"
