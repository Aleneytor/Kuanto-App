# Copia este archivo a ".env.local" para desarrollo local.
# Estas variables se incrustan en el bundle del cliente (prefijo EXPO_PUBLIC_).
# La anon/publishable key es pública por diseño y está protegida por RLS.
# Nunca coloques aquí una clave sb_secret_ ni service_role.
#
# Proyecto: kuanto-mobile (el mismo backend que usa la app móvil de Kuanto).
# En producción (Netlify) se configuran en Site configuration → Environment variables,
# no hace falta commitear un .env con los valores reales.

EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_REEMPLAZAR
